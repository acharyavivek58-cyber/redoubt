node_modules/

# Build output
dist/
*.tsbuildinfo

# SECRETS — never commit. `.env` holds the Discord token, database
# credentials, and (optionally) the Gemini key. `.env.example` IS committed
# and must contain placeholders only.
.env
.env.*
!.env.example

