# REDOUBT — example environment
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every value below is a placeholder; nothing here is a real credential.

# --- Discord (required) ---
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=000000000000000000

# --- Database (required) ---
# PostgreSQL is the only datastore. There is no Redis.
# Replace USER / PASSWORD / HOST with your real connection details.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Jobs (pg-boss, same database) ---
JOBS_ENABLED=true
JOBS_CONCURRENCY=5

# --- Sharding (optional; 0 = single process) ---
# SHARD_ID is set automatically on each spawned shard; do not set it manually.
SHARD_TOTAL=0
RUN_MIGRATIONS=true

# --- AI (OPTIONAL, free tier only) ---
# With no key the bot runs normally and every AI feature disables itself.
# There is no paid fallback, and no quota is hard-coded anywhere.
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# AI_MAX_OUTPUT_TOKENS=1000

# --- Observability ---
LOG_LEVEL=info
LOG_PRETTY=false
